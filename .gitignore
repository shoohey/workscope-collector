# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/

# PyInstaller
build/
dist/
*.manifest

# Local data (must NEVER be committed - may contain captured screen data)
data/
screenshots/
events/
*.jsonl
*.png
*.jpg

# Local artifacts
build-artifacts/
*.zip

# Customer build artifacts (generated by build_for_customer.sh, must NEVER be committed)
src/_build_constants.py

# Secrets / OAuth 資格情報 (must NEVER be committed)
# CI は Secret から oauth-creds.json を生成する。ローカルビルド時の誤コミットも防ぐ。
oauth-creds.json
oauth-*.json
*-oauth.json
client_secret*.json
service-account*.json
service_account*.json
*.pem
*.key

# Editor
.vscode/
.idea/
.DS_Store

# Environment
.env
.env.local
*.log
